# Ave Tenebrae's local configuration. Copy this file to ".env" at the root of the repository:
#
#     cp .env.example .env
#
# ".env" is not versioned (see .gitignore): that is where, and nowhere in the code, the connection
# details live. tenebrae/application/config.py reads it once at start-up.

# Where to reach MongoDB, and which database to write into. The last segment of the URI is the
# database name; "tenebrae" is the one tenebrae/application/README.md uses.
MONGODB_URI=mongodb://localhost:27017/tenebrae

# What signs the session cookie. Without it, the application refuses to start: a key drawn at
# random at every launch would disconnect everyone at every restart. Make one, once and for all:
#
#     python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# The Discord application that identifies the players. It is created at the Developer Portal
# (https://discord.com/developers/applications) - the steps are in tenebrae/application/README.md,
# "Setting up a Discord application".
#
# The redirect URI must be declared in the portal **to the character**: "localhost" is not
# "127.0.0.1" there, and one extra "/" is enough to make the exchange fail.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://127.0.0.1:5000/login/return

# Who may fix the map (/admin/map_fix), by Discord identifier, comma-separated. An empty list
# admits nobody - deliberately: a security variable whose absence would open everything would be a
# trap. To read one's own identifier, enable developer mode in Discord (Settings > Advanced), then
# "Copy ID" on one's own profile.
ADMIN_DISCORD_IDS=

# "yes" behind HTTPS, so that the session cookie only travels encrypted. Locally we speak
# http://127.0.0.1, where a "Secure" cookie would not be set at all: leave "no".
SECURE_COOKIE=no
